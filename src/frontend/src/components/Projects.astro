---
// src/components/Projects.astro
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const allProjects = await getCollection(lang === "en" ? "projectsEn" : "projectsEs");
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<section class="py-20 relative z-10" id="proyectos">
  <div class="mb-12 px-4 max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-green-400 uppercase tracking-widest">
      {t('proyectos.titulo')}
    </h2>
    <p class="text-green-100/60 mt-2">{t('proyectos.subtitulo')}</p>
  </div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto px-4">
  {
    projects.map(({ data }) => (
      <div class="relative flex flex-col bg-[#0a1a0a]/80 backdrop-blur-md border-l-4 border-l-green-500 border-y border-r border-green-500/20 rounded-r-xl p-8 hover:shadow-[0_0_30px_rgba(0,255,0,0.15)] transition-all">
        <h3 class="text-2xl font-bold text-white mb-3">{data.title}</h3>
        
        <p class="text-green-100/80 mb-6 flex-grow">
          {data.description}
        </p>

        <div class="flex items-center justify-between gap-4 mt-auto pt-4">
          <div class="flex flex-wrap gap-2">
            {data.tags.map((tag) => (
              <span class="text-xs font-mono bg-green-500/10 text-green-400 px-2 py-1 rounded border border-green-500/20">
                {tag}
              </span>
            ))}
          </div>
          <a href={data.link} class="text-green-400 hover:text-green-300 font-bold flex items-center gap-2 group shrink-0">
            {t('proyectos.verCodigo')}
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    ))
  }
</div>
</section>