---
// src/components/Projects.astro
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const allProjects = await getCollection(lang === "en" ? "projectsEn" : "projectsEs");
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<section class="py-20 relative z-10" id="proyectos">
  <div class="mb-8 px-4 max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-accent uppercase tracking-widest">
      {t('proyectos.titulo')}
    </h2>
    <p class="text-muted/60 mt-2">{t('proyectos.subtitulo')}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto px-4">
    {
      projects.map(({ data }) => (
        <div class="relative flex flex-col bg-surface/80 backdrop-blur-md border-l-4 border-l-accent border-y border-r border-accent/20 rounded-r-xl p-8 hover:shadow-glow transition-all">
          <h3 class="text-2xl font-bold text-text mb-3">{data.title}</h3>

          <p class="text-muted/80 mb-6 flex-grow">{data.description}</p>

          <div class="flex items-center justify-between gap-4 mt-auto pt-4">
            <div class="flex flex-wrap gap-2">
              {data.tags.map((tag) => (
                <span class="text-xs font-mono bg-accent/10 text-accent px-2 py-1 rounded border border-accent/20">
                  {tag}
                </span>
              ))}
            </div>
            <a href={data.link} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-light font-bold flex items-center gap-2 group shrink-0">
              {t('proyectos.verCodigo')}
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>