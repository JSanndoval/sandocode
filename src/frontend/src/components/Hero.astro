---
// src/components/Hero.astro
import { useTranslations } from '../i18n/utils';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
---
<section class="container mx-auto px-4 py-20 max-w-5xl pt-32" id="inicio">
  <div class="glass border border-accent/30 shadow-glow rounded-2xl p-8 md:p-12 relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent"></div>

    <h1 class="text-4xl md:text-5xl font-bold mb-6 bg-clip-text bg-gradient-to-b text-accent to-accent-dark">
      {t('hero.titulo')}
    </h1>

    <p class="text-lg md:text-xl text-muted/80 mb-8 leading-relaxed">
      {t('hero.descripcion')}
    </p>

    <a href="#proyectos" class="inline-block px-6 py-3 bg-accent/10 hover:bg-accent/20 border border-accent/50 hover:border-accent text-accent font-semibold rounded-lg transition-all shadow-glow-sm hover:shadow-glow-lg">
      {t('hero.boton')}
    </a>
  </div>
</section>