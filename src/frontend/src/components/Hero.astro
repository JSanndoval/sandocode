---
// src/components/Hero.astro
import { useTranslations } from '../i18n/utils';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
---
<section class="container mx-auto px-4 py-20 max-w-4xl pt-32" id="inicio">
  <div class="bg-black/40 backdrop-blur-md border border-green-500/30 shadow-[0_0_30px_rgba(0,255,0,0.1)] rounded-2xl p-8 md:p-12 relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-green-400/50 to-transparent"></div>

    <h1 class="text-4xl md:text-5xl font-bold mb-6 pb-2 text-transparent bg-clip-text bg-gradient-to-b from-green-300 to-green-600">
      {t('hero.titulo')}
    </h1>

    <p class="text-lg md:text-xl text-green-100/80 mb-12 leading-relaxed">
      {t('hero.descripcion')}
    </p>

    <a href="#proyectos" class="inline-block px-6 py-3 bg-green-500/10 hover:bg-green-500/20 border border-green-500/50 hover:border-green-400 text-green-400 font-semibold rounded-lg transition-all shadow-[0_0_15px_rgba(0,255,0,0.2)] hover:shadow-[0_0_25px_rgba(0,255,0,0.4)]">
      {t('hero.boton')}
    </a>
  </div>
</section>