---
// src/components/Contact.astro
import { useTranslations } from '../i18n/utils';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
---
<section class="py-20 relative z-10" id="contacto">
  <div class="max-w-3xl mx-auto px-4">
    <div class="bg-black/40 backdrop-blur-md border border-green-500/20 rounded-2xl p-8 md:p-12 shadow-[0_0_30px_rgba(0,255,0,0.05)]">
      <h2 class="text-3xl font-bold text-green-400 mb-6 text-center">{t('contacto.titulo')}</h2>
      
      <!-- Agregamos netlify-honeypot="bot-field" -->
      <form name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
        
        <!-- Este es el campo trampa. La clase 'hidden' lo oculta a los humanos -->
        <p class="hidden">
          <label>
            No llenes este campo si eres humano: <input name="bot-field" />
          </label>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="nombre" class="block text-green-200 text-sm mb-2">{t('contacto.nombre')}</label>
            <input type="text" id="nombre" name="nombre" required class="w-full bg-[#051005]/50 border border-green-500/30 rounded-lg px-4 py-3 text-green-50 focus:outline-none focus:border-green-400 focus:ring-1 focus:ring-green-400 transition-colors">
          </div>
          <div>
            <label for="email" class="block text-green-200 text-sm mb-2">{t('contacto.email')}</label>
            <input type="email" id="email" name="email" required class="w-full bg-[#051005]/50 border border-green-500/30 rounded-lg px-4 py-3 text-green-50 focus:outline-none focus:border-green-400 focus:ring-1 focus:ring-green-400 transition-colors">
          </div>
        </div>
        
        <div>
          <label for="mensaje" class="block text-green-200 text-sm mb-2">{t('contacto.mensaje')}</label>
          <textarea id="mensaje" name="mensaje" rows="4" required class="w-full bg-[#051005]/50 border border-green-500/30 rounded-lg px-4 py-3 text-green-50 focus:outline-none focus:border-green-400 focus:ring-1 focus:ring-green-400 transition-colors resize-none"></textarea>
        </div>

        <button type="submit" class="w-full px-6 py-4 bg-green-500/10 hover:bg-green-500/20 border border-green-500/50 hover:border-green-400 text-green-400 font-bold rounded-lg transition-all">
          {t('contacto.enviar')}
        </button>
      </form>
    </div>
  </div>
</section>