---
// src/components/Contact.astro
import { useTranslations } from '../i18n/utils';
import { SITE } from '../config';

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
const thanksUrl = lang === "en" ? SITE.form.thanksPath.en : SITE.form.thanksPath.es;

const inputClass = "w-full bg-bg/50 border border-accent/30 rounded-lg px-4 py-3 text-text focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors";
---
<section class="py-20 relative z-10" id="contacto">
  <div class="max-w-3xl mx-auto px-4">
    <div class="glass border border-accent/20 rounded-2xl p-8 md:p-12 shadow-glow">
      <h2 class="text-3xl font-bold text-accent mb-6 text-center">{t('contacto.titulo')}</h2>

      <form
        name={lang === "en" ? "contact-en" : SITE.form.name}
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action={thanksUrl}
        class="space-y-6"
      >
        <input type="hidden" name="subject" value={`Nuevo mensaje desde ${SITE.title}`} />

        <p class="hidden">
          <label>
            No llenes este campo si eres humano:
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="nombre" class="block text-muted text-sm mb-2">{t('contacto.nombre')}</label>
            <input type="text" id="nombre" name="nombre" autocomplete="name" required class={inputClass}>
          </div>
          <div>
            <label for="email" class="block text-muted text-sm mb-2">{t('contacto.email')}</label>
            <input type="email" id="email" name="email" autocomplete="email" required class={inputClass}>
          </div>
        </div>

        <div>
          <label for="mensaje" class="block text-muted text-sm mb-2">{t('contacto.mensaje')}</label>
          <textarea id="mensaje" name="mensaje" rows="4" required class={`${inputClass} resize-none`}></textarea>
        </div>

        <button type="submit" class="w-full px-6 py-4 bg-accent/10 hover:bg-accent/20 border border-accent/50 hover:border-accent text-accent font-bold rounded-lg transition-all">
          {t('contacto.enviar')}
        </button>
      </form>
    </div>
  </div>
</section>