---
// src/components/About.astro
import { useTranslations } from '../i18n/utils';
import { SITE } from '../config';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const stack = ["Astro", "Angular", ".NET Core", "Next.js", "TypeScript", "Tailwind CSS"];

const initials = "JS";
const photoUrl = SITE.about.photoUrl;
---

<section class="py-20 relative z-10" id="sobre-mi">
  <div class="max-w-5xl mx-auto px-4">
    <div class="glass border border-accent/20 rounded-2xl p-8 md:p-12 shadow-glow grid grid-cols-1 md:grid-cols-[auto_1fr] gap-8 items-center">
      <div class="flex md:block justify-center">
        {photoUrl ? (
          <img
            src={photoUrl}
            alt={t('sobremi.nombre')}
            class="w-28 h-28 md:w-36 md:h-36 rounded-full object-cover bg-gradient-to-br from-accent to-accent-dark shadow-glow shrink-0"
          />
        ) : (
          <div
            aria-hidden="true"
            class="w-28 h-28 md:w-36 md:h-36 rounded-full bg-gradient-to-br from-accent to-accent-dark flex items-center justify-center text-3xl md:text-4xl font-bold text-bg shadow-glow shrink-0"
          >
            {initials}
          </div>
        )}
      </div>

      <div>
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-accent uppercase tracking-widest mb-3">
          <span class="w-2 h-2 rounded-full bg-accent shadow-glow-sm animate-pulse"></span>
          {t('sobremi.disponible')}
        </span>

        <h2 class="text-3xl font-bold text-accent mb-1">{t('sobremi.titulo')}</h2>
        <p class="text-muted/60 mb-4">{t('sobremi.nombre')} — {t('sobremi.rol')}</p>

        <p class="text-muted/80 leading-relaxed mb-6">
          {t('sobremi.bio')}
        </p>

        <p class="text-xs font-semibold text-muted/50 uppercase tracking-widest mb-3">{t('sobremi.stack')}</p>
        <div class="flex flex-wrap gap-2">
          {stack.map((tech) => (
            <span class="text-xs font-mono bg-accent/10 text-accent px-3 py-1.5 rounded-full border border-accent/20">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
