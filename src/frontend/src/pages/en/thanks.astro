---
// src/pages/en/gracias.astro
import Layout from '../../layouts/Layout.astro';
---
<Layout lang="en">
  <section class="container mx-auto px-4 py-20 max-w-2xl pt-40 text-center">
    <div class="glass border border-accent/30 rounded-2xl p-12">
      <h1 class="text-4xl font-bold mb-4 text-accent">Message sent!</h1>
      <p class="text-muted/80 mb-8">Thank you for writing to me. I will respond as soon as possible.</p>
      <a href="/" class="inline-block px-6 py-3 bg-accent/10 hover:bg-accent/20 border border-accent/50 hover:border-accent text-accent font-semibold rounded-lg transition-all">
        Back to home
      </a>
    </div>
  </section>
</Layout>