---
// src/layouts/Layout.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';
import { SITE } from '../config';

interface Props { lang?: "es" | "en"; }
const { lang = SITE.defaultLang } = Astro.props;
const t = useTranslations(lang);

const pageTitle = `${SITE.title} - ${SITE.tagline}`;
const ogUrl = new URL(SITE.ogImage, SITE.website).href;
---
<html lang={lang} dir={SITE.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={lang === "es" ? SITE.desc : SITE.descEn} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE.website).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={lang === "es" ? SITE.desc : SITE.descEn} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:url" content={SITE.website} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-bg min-h-screen text-text font-sans selection:bg-accent selection:text-black">
    {SITE.backdropEffects.leftGlow && (
      <div class="fixed top-[-10%] left-[-10%] w-[50vw] h-[50vw] bg-accent/20 rounded-full blur-[120px] pointer-events-none"></div>
    )}
    {SITE.backdropEffects.rightGlow && (
      <div class="fixed bottom-[-10%] right-[-10%] w-[40vw] h-[40vw] bg-accent/20 rounded-full blur-[120px] pointer-events-none"></div>
    )}

    <main class="relative z-10">
      <Navbar lang={lang} />
      <slot />
      <Footer lang={lang} />
    </main>
  </body>
</html>