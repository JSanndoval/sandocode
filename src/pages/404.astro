---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeUrl = lang === "en" ? "/en" : "/";
---

<Layout lang={lang}>
  <section
    class="container mx-auto px-4 py-20 max-w-2xl pt-40 text-center min-h-[70vh] flex items-center justify-center"
  >
    <div
      class="glass border border-accent/30 shadow-glow rounded-2xl p-12 w-full"
    >
      <p
        class="text-7xl md:text-8xl font-bold text-transparent bg-clip-text bg-gradient-to-b from-accent-light to-accent-dark mb-4"
      >
        404
      </p>
      <h1 class="text-2xl md:text-3xl font-bold text-text mb-3">
        {t("404.titulo")}
      </h1>
      <p class="text-muted/70 mb-8">
        {t("404.desc")}
      </p>
      <a
        href={homeUrl}
        class="inline-block px-6 py-3 bg-accent/10 hover:bg-accent/20 border border-accent/50 hover:border-accent text-accent font-semibold rounded-lg transition-all shadow-glow-sm hover:shadow-glow-lg"
      >
        {t("404.boton")}
      </a>
    </div>
  </section>
</Layout>
