---
// src/pages/en/index.astro
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Stats from '../../components/Stats.astro';
import Services from '../../components/Services.astro';
import Process from '../../components/Process.astro';
import Projects from '../../components/Projects.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { SITE } from '../../config';
import Experience from '../../components/Experience.astro';

const lang = getLangFromUrl(Astro.url);
---
<Layout lang={lang} alternate="/">
  <Hero lang={lang} />
  {SITE.sections.showProjects && <Projects lang={lang} />}
  {SITE.sections.showAbout && <About lang={lang} />}
  {SITE.sections.showStats && <Stats lang={lang} />}
  {SITE.sections.showExperience && <Experience lang={lang} />}
  {SITE.sections.showServices && <Services lang={lang} />}
  {SITE.sections.showProcess && <Process lang={lang} />}
  {SITE.sections.showFaq && <Faq lang={lang} />}
  {SITE.sections.showContact && <Contact lang={lang} />}
</Layout>