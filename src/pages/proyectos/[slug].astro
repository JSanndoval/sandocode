---
// src/pages/proyectos/[slug].astro
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import { existsSync } from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const projects = await getCollection('projectsEs');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const lang = "es" as const;
const t = useTranslations(lang);
const d = project.data;

const hasImage = (src?: string) =>
  !!src && (src.startsWith('http') || existsSync(path.join(process.cwd(), 'public', src)));
---

<Layout lang={lang} title={d.title} description={d.summary} image={d.image} alternate={`/proyectos/${project.id}/`}>
  <article class="pt-32 pb-24 relative z-10">
    <div class="max-w-3xl mx-auto px-4">

      <a href="/#proyectos" class="inline-flex items-center gap-2 text-sm text-muted/50 hover:text-accent transition-colors mb-10">
        <span>←</span> {t('proyectos.volver')}
      </a>

      <div class="flex items-center gap-3 mb-4 text-xs font-mono text-muted/40">
        <span>{t(`cat.${d.category}`)}</span>
        <span class="w-1 h-1 rounded-full bg-muted/30"></span>
        <span>{d.year}</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-bold text-text tracking-tight leading-tight mb-6">
        {d.title}
      </h1>

      <p class="text-lg md:text-xl text-muted/70 leading-relaxed mb-8">
        {d.summary}
      </p>

      <div class="flex flex-wrap items-center gap-4 mb-12">
        {d.demo && (
          <a href={d.demo} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent text-bg font-semibold text-sm rounded-lg hover:bg-accent-light transition-colors">
            {t('proyectos.verSitio')} <span>→</span>
          </a>
        )}
        {d.repo && (
          <a href={d.repo} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 px-5 py-2.5 border border-accent/30 text-muted/80 font-semibold text-sm rounded-lg hover:border-accent/60 hover:text-accent transition-colors">
            {t('proyectos.verCodigo')}
          </a>
        )}
      </div>
    </div>

    {hasImage(d.image) && (
      <div class="max-w-5xl mx-auto px-4 mb-14">
        <img
          src={d.image}
          alt={d.imageAlt ?? d.title}
          width="1440" height="900"
          class="w-full rounded-2xl border border-accent/15 shadow-glow"
        />
      </div>
    )}

    <div class="max-w-3xl mx-auto px-4">
      <div class="glass border border-accent/15 rounded-xl p-6 mb-12">
        <p class="text-xs font-semibold text-muted/40 uppercase tracking-widest mb-2">
          {t('proyectos.contexto')}
        </p>
        <p class="text-muted/75 leading-relaxed">{d.description}</p>
      </div>

      <div class="case-content">
        <Content />
      </div>

      <div class="mt-14 pt-8 border-t border-accent/10">
        <p class="text-xs font-semibold text-muted/40 uppercase tracking-widest mb-4">
          {t('proyectos.stack')}
        </p>
        <div class="flex flex-wrap gap-2">
          {d.tags.map((tag) => (
            <span class="text-xs font-mono text-muted/60 bg-white/5 px-3 py-1.5 rounded">{tag}</span>
          ))}
        </div>
      </div>

      <a href="/#proyectos" class="inline-flex items-center gap-2 text-sm text-accent hover:text-accent-light transition-colors mt-12">
        <span>←</span> {t('proyectos.volver')}
      </a>
    </div>
  </article>
</Layout>

<style is:global>
  .case-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 2.75rem;
    margin-bottom: 0.875rem;
    letter-spacing: -0.01em;
  }
  .case-content h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-accent-light);
    margin-top: 2rem;
    margin-bottom: 0.625rem;
  }
  .case-content p {
    color: color-mix(in srgb, var(--color-muted) 75%, transparent);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }
  .case-content ul {
    list-style: none;
    margin-bottom: 1.5rem;
  }
  .case-content li {
    color: color-mix(in srgb, var(--color-muted) 75%, transparent);
    line-height: 1.8;
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.5rem;
  }
  .case-content li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
  .case-content strong { color: var(--color-text); font-weight: 600; }
  .case-content code {
    font-family: ui-monospace, monospace;
    font-size: 0.875em;
    color: var(--color-accent);
    background: color-mix(in srgb, white 6%, transparent);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
  }
  .case-content a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
</style>