---
// src/components/About.astro
import { useTranslations } from '../i18n/utils';
import { SITE } from '../config';
import { Image } from 'astro:assets';
import foto from '../assets/Foto-cv.webp';

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const stack = ["Astro", "Angular", ".NET Core", "Next.js", "TypeScript", "Tailwind CSS"];
---

<section class="py-24 relative z-10" id="sobre-mi">
  <div class="max-w-5xl mx-auto px-4">
    <div class="glass border border-border rounded-2xl p-8 md:p-12 shadow-glow grid grid-cols-1 md:grid-cols-[auto_1fr] gap-8 items-center">
      <div class="flex md:block justify-center">
        <Image
          src={foto}
          alt={t('sobremi.nombre')}
          width={288}
          height={288}
          quality={82}
          class="w-28 h-28 md:w-36 md:h-36 rounded-full object-cover shadow-glow shrink-0"
        />
      </div>

      <div>
        <h2 class="text-3xl font-bold text-accent mb-1">{t('sobremi.titulo')}</h2>
        <p class="text-muted/60 mb-4">{t('sobremi.nombre')} — {t('sobremi.rol')}</p>

        <p class="text-muted/80 leading-relaxed mb-6">
          {t('sobremi.bio')}
        </p>

        <p class="text-xs font-semibold text-muted/65 uppercase tracking-widest mb-3">{t('sobremi.stack')}</p>
        <div class="flex flex-wrap gap-2">
          {stack.map((tech) => (
            <span class="text-xs font-mono bg-accent/10 text-accent px-3 py-1.5 rounded-full border border-border">
              {tech}
            </span>
          ))}
                  <div class="mt-8 pt-7 border-t border-border/60">
          <p class="text-xs font-semibold text-accent uppercase tracking-widest mb-3">
            {t('sobremi.rumbo')}
          </p>
          <p class="text-muted/75 leading-relaxed mb-5">
            {t('sobremi.rumboTexto')}
          </p>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>
