---
// src/components/Faq.astro
import { useTranslations } from '../i18n/utils';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const items = ["1", "2", "3", "4", "5"] as const;
---

<section class="py-24 relative z-10" id="faq">
  <div class="max-w-3xl mx-auto px-4">

    <header class="mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        {t('faq.titulo')}
      </h2>
    </header>

    <div class="divide-y divide-border border-t border-b border-border">
      {items.map((key) => (
        <details class="group py-5">
          <summary class="flex items-start justify-between gap-6 cursor-pointer list-none text-text font-semibold hover:text-accent transition-colors">
            {t(`faq.${key}.pregunta`)}
            <svg
              class="w-4 h-4 shrink-0 mt-1 text-accent transition-transform duration-300 group-open:rotate-45"
              fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="text-sm text-muted/70 leading-relaxed mt-4 pr-10">
            {t(`faq.${key}.respuesta`)}
          </p>
        </details>
      ))}
    </div>

  </div>
</section>