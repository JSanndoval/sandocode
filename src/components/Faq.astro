---
// src/components/Faq.astro
import { useTranslations } from '../i18n/utils';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const items = ["1", "2", "3", "4", "5"] as const;
---

<section class="py-20 relative z-10" id="faq">
  <div class="max-w-3xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-dark uppercase tracking-widest">
        {t('faq.titulo')}
      </h2>
      <div class="h-px w-24 bg-accent/50 mx-auto mt-4 shadow-glow-sm"></div>
    </div>

    <div class="space-y-4">
      {
        items.map((key) => (
          <details class="glass border border-accent/20 rounded-xl p-5 group open:border-accent/50 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-text list-none">
              {t(`faq.${key}.pregunta`)}
              <span class="text-accent text-xl shrink-0 ml-4 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-muted/70 text-sm leading-relaxed mt-3">{t(`faq.${key}.respuesta`)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
