---
// src/components/Services.astro
import { useTranslations } from '../i18n/utils';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    key: "1",
    // Rayo — velocidad de carga
    path: "M13 2L4.5 13.5H11l-1 8.5L19.5 10H13l1-8z",
  },
  {
    key: "2",
    // Bolsa de compra — e-commerce
    path: "M5.5 7.5h13l1 13h-15l1-13zM9 7.5V5a3 3 0 016 0v2.5",
  },
  {
    key: "3",
    // Flechas de intercambio — integraciones
    path: "M4 8.5h12m0 0l-3.5-3.5M16 8.5L12.5 12M20 15.5H8m0 0l3.5-3.5M8 15.5L11.5 19",
  },
] as const;
---

<section class="py-24 relative z-10" id="servicios">
  <div class="max-w-5xl mx-auto px-4">

    <header class="mb-12 max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        {t('servicios.titulo')}
      </h2>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((service) => (
        <div class="bg-surface/40 border border-border rounded-xl p-7 hover:border-accent/40 transition-colors duration-300 group">
          <div class="w-11 h-11 rounded-lg bg-accent/10 flex items-center justify-center mb-5 group-hover:bg-accent/15 transition-colors">
            <svg
              class="w-5 h-5 text-accent"
              fill="none" stroke="currentColor" stroke-width="1.75"
              stroke-linecap="round" stroke-linejoin="round"
              viewBox="0 0 24 24" aria-hidden="true"
            >
              <path d={service.path} />
            </svg>
          </div>

          <h3 class="text-lg font-bold text-text mb-2.5">
            {t(`servicios.${service.key}.titulo`)}
          </h3>
          <p class="text-sm text-muted/70 leading-relaxed">
            {t(`servicios.${service.key}.desc`)}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>