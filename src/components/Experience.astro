---
// src/components/Experience.astro
import { getCollection } from "astro:content";
import { useTranslations } from "../i18n/utils";

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const all = await getCollection(
  lang === "en" ? "experienceEn" : "experienceEs",
);
const sorted = all.sort((a, b) => a.data.order - b.data.order);

const work = sorted.filter((e) => e.data.type === "work");
const education = sorted.filter((e) => e.data.type === "education");

const MONTHS: Record<string, string[]> = {
  es: [
    "Ene",
    "Feb",
    "Mar",
    "Abr",
    "May",
    "Jun",
    "Jul",
    "Ago",
    "Sep",
    "Oct",
    "Nov",
    "Dic",
  ],
  en: [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
  ],
};

const fmt = (ym: string) => {
  const [y, m] = ym.split("-");
  return `${MONTHS[lang][Number(m) - 1]} ${y}`;
};

const range = (start: string, end: string | null) =>
  `${fmt(start)} — ${end ? fmt(end) : t("experiencia.actual")}`;

const groups = [
  { label: t("experiencia.trabajo"), items: work },
  { label: t("experiencia.educacion"), items: education },
];
---

<section class="py-24 relative z-10" id="experiencia">
  <div class="max-w-5xl mx-auto px-4">
    <header class="mb-12 max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        {t("experiencia.titulo")}
      </h2>
      <p class="text-muted/65 mt-3 text-lg">{t("experiencia.subtitulo")}</p>
    </header>

    <div class="grid md:grid-cols-2 gap-12 md:gap-10">
      {
        groups.map((group) => (
          <div>
            <p class="text-xs font-semibold text-muted/60 uppercase tracking-widest mb-7">
              {group.label}
            </p>

            <ol class="relative border-l border-border pl-7 space-y-9">
              {group.items.map((e, i) => (
                <li class="relative">
                  <span
                    class:list={[
                      "absolute -left-[33px] top-1.5 w-[11px] h-[11px] rounded-full border-2",
                      e.data.end === null
                        ? "bg-accent border-accent shadow-glow-sm"
                        : "bg-bg border-accent/40",
                    ]}
                  />

                  <p class="text-xs font-mono text-muted/60 mb-1.5">
                    {range(e.data.start, e.data.end)}
                  </p>

                  <h3 class="text-base font-bold text-text leading-snug">
                    {e.data.role}
                  </h3>
                  <p class="text-sm text-accent/80 mb-2.5">{e.data.company}</p>

                  <p class="text-sm text-muted/65 leading-relaxed mb-3">
                    {e.data.description}
                  </p>

                  <div class="flex flex-wrap gap-1.5">
                    {e.data.tags.map((tag) => (
                      <span class="text-[11px] font-mono text-muted/65 bg-white/5 px-2 py-0.5 rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>
