---
// src/components/Process.astro
import { useTranslations } from '../i18n/utils';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const steps = ["1", "2", "3", "4"] as const;
---

<section class="py-20 relative z-10" id="proceso">
  <div class="text-center mb-12 px-4">
    <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-dark uppercase tracking-widest">
      {t('proceso.titulo')}
    </h2>
    <div class="h-px w-24 bg-accent/50 mx-auto mt-4 shadow-glow-sm"></div>
    <p class="text-muted/60 mt-4 max-w-xl mx-auto">{t('proceso.subtitulo')}</p>
  </div>

  <div class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-6">
    {
      steps.map((key, i) => (
        <div class="glass border border-accent/20 rounded-xl p-6 relative">
          <span class="text-5xl font-bold text-accent/20 absolute top-4 right-4 leading-none select-none">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="text-lg font-bold text-accent-light mb-2 relative">{t(`proceso.${key}.titulo`)}</h3>
          <p class="text-muted/70 text-sm leading-relaxed relative">{t(`proceso.${key}.desc`)}</p>
        </div>
      ))
    }
  </div>
</section>
