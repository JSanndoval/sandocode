---
// src/components/Process.astro
import { useTranslations } from '../i18n/utils';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const steps = ["1", "2", "3", "4"] as const;
---

<section class="py-24 relative z-10" id="proceso">
  <div class="max-w-5xl mx-auto px-4">

    <header class="mb-14 max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        {t('proceso.titulo')}
      </h2>
      <p class="text-muted/50 mt-3 text-lg">{t('proceso.subtitulo')}</p>
    </header>

    <div class="relative">
      <!-- Línea que conecta los pasos (solo escritorio) -->
      <div class="hidden md:block absolute top-[22px] left-[10%] right-[10%] h-px bg-border"></div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-6">
        {steps.map((key, i) => (
          <div class="relative">
            <div class="w-11 h-11 rounded-full border border-accent/40 bg-bg text-accent font-display font-bold flex items-center justify-center mb-5 relative z-10">
              {i + 1}
            </div>

            <h3 class="text-base font-bold text-text mb-2">
              {t(`proceso.${key}.titulo`)}
            </h3>
            <p class="text-sm text-muted/65 leading-relaxed">
              {t(`proceso.${key}.desc`)}
            </p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>