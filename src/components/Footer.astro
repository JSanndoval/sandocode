---
// src/components/Footer.astro
import { useTranslations } from '../i18n/utils';
import { SITE } from '../config';

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const socials = SITE.socials.filter((s) => s.enabled);
---
<footer class="relative z-10 border-t border-accent/20 glass mt-20">
  <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col md:flex-row justify-between items-center gap-4">
    <p class="text-muted/65 text-sm text-center md:text-left">
      © {year} {SITE.author}. {t('footer.creditos')}
    </p>
    <div class="flex space-x-4">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-muted/65 hover:text-accent transition-colors">
          {s.name}
        </a>
      ))}
    </div>
  </div>
</footer>