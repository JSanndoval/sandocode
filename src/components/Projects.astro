---
// src/components/Projects.astro
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import { existsSync } from 'node:fs';
import path from 'node:path';

const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const allProjects = await getCollection(lang === "en" ? "projectsEn" : "projectsEs");

// Destacados primero, luego por order
const projects = allProjects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order;
});

// true solo si la imagen existe en /public (o es una URL externa)
const hasImage = (src?: string) =>
  !!src && (src.startsWith('http') || existsSync(path.join(process.cwd(), 'public', src)));
---

<section class="py-20 relative z-10" id="proyectos">
  <div class="mb-10 px-4 max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-accent uppercase tracking-widest">
      {t('proyectos.titulo')}
    </h2>
    <p class="text-muted/60 mt-2">{t('proyectos.subtitulo')}</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto px-4">
    {
      projects.map(({ id, data }) => (
        <article class="group flex flex-col bg-surface/60 backdrop-blur-md border border-accent/15 rounded-xl overflow-hidden hover:border-accent/50 hover:shadow-glow transition-all duration-300">

          <div class="relative aspect-video overflow-hidden border-b border-accent/10">
            {hasImage(data.image) ? (
              <img
                src={data.image}
                alt={data.imageAlt ?? data.title}
                loading="lazy"
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-accent/15 via-surface to-bg flex items-center justify-center">
                <span class="text-6xl font-bold text-accent/30 select-none">
                  {data.title.charAt(0)}
                </span>
              </div>
            )}

            <span class="absolute top-3 right-3 text-[11px] font-mono bg-bg/80 backdrop-blur-sm text-accent px-2 py-1 rounded border border-accent/30">
              {t(`cat.${data.category}`)}
            </span>
          </div>

          <div class="flex flex-col flex-grow p-6">
            <div class="flex items-baseline justify-between gap-3 mb-2">
              <h3 class="text-xl font-bold text-text">{data.title}</h3>
              <span class="text-xs font-mono text-muted/40 shrink-0">{data.year}</span>
            </div>

            <p class="text-sm text-muted/70 leading-relaxed mb-5 flex-grow">
              {data.description}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-5">
              {data.tags.map((tag) => (
                <span class="text-[11px] font-mono bg-accent/10 text-accent px-2 py-0.5 rounded border border-accent/20">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-3 mt-auto pt-4 border-t border-accent/10">
              {data.demo && (
                <a href={data.demo} target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent-light transition-colors">
                  {t('proyectos.verSitio')}
                  <span class="group-hover:translate-x-0.5 transition-transform">→</span>
                </a>
              )}
              {data.repo && (
                <a href={data.repo} target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-1.5 text-sm text-muted/60 hover:text-accent transition-colors">
                  {t('proyectos.verCodigo')}
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>