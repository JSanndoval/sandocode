---
// src/components/Stats.astro
import { useTranslations } from '../i18n/utils';
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);

const stats = ["1", "2", "3", "4"] as const;
---

<section class="py-10 relative z-10" aria-label={t('sobremi.titulo')}>
  <div class="max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {
        stats.map((key) => (
          <div class="bg-surface/40 border border-border rounded-xl p-5 text-center hover:border-accent/40 transition-colors">
            <p class="text-2xl md:text-3xl font-bold text-accent">{t(`stats.${key}.valor`)}</p>
            <p class="text-xs md:text-sm text-muted/60 mt-1">{t(`stats.${key}.label`)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
